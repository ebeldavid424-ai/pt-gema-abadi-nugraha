rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid))
        ? get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role
        : 'OPERATOR';
    }

    function isOwner() {
      return isSignedIn() && (
        request.auth.token.email == 'ebeldavid424@gmail.com' || getUserRole() == 'OWNER'
      );
    }

    function isRole(roles) {
      return isSignedIn() && (isOwner() || getUserRole() in roles);
    }

    function validTransactionCreate() {
      return request.resource.data.keys().hasAll([
        'trxNumber', 'type', 'date', 'unitId', 'totalAmount', 'paymentMethod', 'status', 'createdBy', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.totalAmount is number
      && request.resource.data.totalAmount > 0
      && request.resource.data.status == 'ACTIVE'
      && request.resource.data.createdBy == request.auth.token.email
      && request.resource.data.unitId is string
      && request.resource.data.unitId.size() > 0
      && (
        !(request.resource.data.type in ['SALE', 'PURCHASE']) ||
        (request.resource.data.itemCategory is string && request.resource.data.itemCategory.size() > 0)
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /test/{docId} {
      allow read: if isSignedIn();
    }

    match /transactions/{transactionId} {
      allow read: if isSignedIn();
      allow create: if isRole(['OWNER','ADMIN','AKUNTAN','KASIR','SALES','OPERATOR']) && validTransactionCreate();
      allow update: if isRole(['OWNER','ADMIN','AKUNTAN']);
      allow delete: if isOwner();
    }

    match /businessUnits/{unitId} {
      allow read: if isSignedIn();
      allow write: if isRole(['OWNER','ADMIN']);
    }

    match /partners/{partnerId} {
      allow read: if isSignedIn();
      allow write: if isRole(['OWNER','ADMIN','SALES','KASIR','AKUNTAN']);
    }

    match /accounts/{accountId} {
      allow read: if isSignedIn();
      allow write: if isRole(['OWNER','ADMIN','AKUNTAN']);
    }

    match /expenseCategories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isRole(['OWNER','ADMIN','AKUNTAN']);
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isRole(['OWNER','ADMIN','SALES']);
    }

    match /documents/{documentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isRole(['OWNER','ADMIN']);
      allow delete: if isRole(['OWNER','ADMIN']);
    }

    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.performedBy == request.auth.token.email;
      allow update, delete: if false;
    }

    match /userProfiles/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (isOwner() || request.auth.uid == userId);
      allow delete: if isOwner();
    }

    match /companyProfile/{profileId} {
      allow read: if isSignedIn();
      allow write: if isRole(['OWNER','ADMIN']);
    }
  }
}
